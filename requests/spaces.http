@baseUrl = http://localhost:53425
@token = paste-new-owner-access-token-here
@spaceId = 1
@rowVersion = paste-latest-rowVersion-here

### Create; copy the returned id and rowVersion
POST {{baseUrl}}/api/spaces
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"Workshop Hall","description":"A room for workshops and meetings","address":"Example Street 10","city":"Tbilisi","capacity":40,"hourlyRate":50}

### Browse active spaces
GET {{baseUrl}}/api/spaces?city=Tbilisi&minCapacity=20&maxHourlyRate=100&page=1&pageSize=20
Authorization: Bearer {{token}}

### My spaces (includes inactive)
GET {{baseUrl}}/api/me/spaces
Authorization: Bearer {{token}}

### Details; copy the latest rowVersion before editing
GET {{baseUrl}}/api/spaces/{{spaceId}}
Authorization: Bearer {{token}}

### Update; copy the new rowVersion after success
PUT {{baseUrl}}/api/spaces/{{spaceId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{"name":"Workshop Hall","description":"A room for workshops and meetings","address":"Example Street 10","city":"Tbilisi","capacity":40,"hourlyRate":60,"rowVersion":"{{rowVersion}}"}

### Replace weekly hours (example: Monday and Tuesday only)
PUT {{baseUrl}}/api/spaces/{{spaceId}}/working-hours
Authorization: Bearer {{token}}
Content-Type: application/json

{"days":[{"dayOfWeek":1,"opensAt":"09:00:00","closesAt":"18:00:00"},{"dayOfWeek":2,"opensAt":"09:00:00","closesAt":"18:00:00"}],"rowVersion":"{{rowVersion}}"}

### View hours
GET {{baseUrl}}/api/spaces/{{spaceId}}/working-hours
Authorization: Bearer {{token}}

### Deactivate; existing bookings remain unchanged
PUT {{baseUrl}}/api/spaces/{{spaceId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{"isActive":false,"rowVersion":"{{rowVersion}}"}
